# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Where the Express API lives. Server-only on purpose — no NEXT_PUBLIC_ prefix.
# The browser never calls the API directly; this app calls it server-side and
# forwards the operator's session token. In production the API listens on
# localhost only, so this stays a loopback address even though the dashboard
# itself is served from admin.rsskylerlimo.com.
API_URL=http://127.0.0.1:4000
