# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Where the Express API lives. Server-only on purpose — no NEXT_PUBLIC_ prefix.
# The browser never calls the API directly; this app calls it server-side and
# forwards the operator's session token. In production the API listens on
# localhost only, so this stays a loopback address even though the dashboard
# itself is served from admin.rsskylerlimo.com.
API_URL=http://127.0.0.1:4000

# Where to tell the public site to refresh its cached fleet after an edit, and
# the secret it expects. REVALIDATE_SECRET must match the public app's value.
WEB_REVALIDATE_URL=https://rsskylerlimo.com/api/revalidate
REVALIDATE_SECRET=

# ONLY for a preview server reachable by bare IP, where no certificate can be
# issued. Drops the Secure flag (and the __Host- prefix) so sign-in works over
# plain HTTP — at the cost of sending the session token in clear text.
# Delete this line the moment the domain and HTTPS are in place.
# COOKIE_INSECURE=true
