# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Where the Express API lives. Server-only on purpose — no NEXT_PUBLIC_ prefix.
# The browser never calls the API directly; this app calls it and forwards the
# operator's session token. In production the API listens on localhost only.
API_URL=http://127.0.0.1:4000

# Shared secret the admin app presents to POST /api/revalidate when an operator
# edits the fleet. Generate with `openssl rand -hex 32` and set the identical
# value in admin/.env.local. Leave it unset and the endpoint returns 503 —
# closed rather than open.
REVALIDATE_SECRET=

# Must match the API's UPLOADS_BASE_URL — next/image will refuse to load
# vehicle photos from a host it has not been told about.
UPLOADS_BASE_URL=http://127.0.0.1:4000/uploads
