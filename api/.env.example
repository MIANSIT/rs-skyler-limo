# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
PORT=4000

# MySQL runs on the same host as the API and is not reachable from the internet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rsskyler
DB_PASSWORD=
DB_NAME=rsskyler
DB_CONNECTION_LIMIT=10

# Browser origins allowed to POST a booking or a quote. Comma separated.
# Server-to-server calls from the Next.js app send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:3000

# How long an operator stays signed in to /admin.
SESSION_TTL_HOURS=12

# Development only, read by `npm run seed`. Omit and a password is generated
# and printed once.
# SEED_ADMIN_EMAIL=ops@rsskylerlimo.com
# SEED_ADMIN_PASSWORD=

# Uploaded vehicle photography. Keep this OUTSIDE the deploy directory in
# production (e.g. /var/lib/rsskyler/uploads) so a release does not delete the
# client's photo library, and include it in the nightly backup.
UPLOADS_DIR=./var/uploads

# How a browser reaches those files. In production let nginx serve the uploads
# directory from the public origin and set this to
# https://rsskylerlimo.com/uploads — that keeps images on the CDN and off the
# API process.
UPLOADS_BASE_URL=http://127.0.0.1:4000/uploads

# Google Places, for address autocomplete and for deciding whether a pickup is
# inside New York City (which is what makes a fixed airport fare available).
#
# Enable "Places API (New)" in a Google Cloud project with billing, create an
# API key, and restrict it to that one API. The key is used server-side only and
# must NOT be given a NEXT_PUBLIC_ prefix — autocomplete fires on every
# keystroke, and a key in the browser is a key on someone else's bill.
#
# Leave it unset and the booking form falls back to a plain address field plus a
# borough selector. Fixed airport fares still work; only the autocomplete goes.
# GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------------------- mail
# Booking confirmations to the customer, notifications to the office.
#
# Leave MAIL and MAIL_APP_PASSWORD unset in development: the API runs exactly
# as before and logs what it would have sent, so nobody needs the live mailbox
# to work on the booking flow.
#
# MAIL_APP_PASSWORD must be an APP PASSWORD, not the account password — Yahoo
# and Gmail both refuse account passwords over SMTP.
#
# It is MAIL_USER, never MAIL: `MAIL` is a POSIX shell variable holding the
# user's mail spool path, and dotenv will not overwrite a variable the shell
# has already set. A `MAIL=` line here is silently ignored on a real server.
MAIL_USER=
MAIL_APP_PASSWORD=
# Defaults suit Yahoo. Port 465 is implicit TLS; 587 would need STARTTLS.
MAIL_HOST=smtp.mail.yahoo.com
MAIL_PORT=465
MAIL_FROM_NAME=RSSkyler Limo
# Who in the business is told about a new booking, comma separated.
MAIL_OPS_RECIPIENTS=
# Used for the "track this booking" link in the customer's email.
SITE_BASE_URL=http://localhost:3000

# Stripe — card payment on priced bookings. Server-side only; never prefix
# with NEXT_PUBLIC_. Test keys (sk_test_…) everywhere except production.
# Unset, card bookings are paid to the office as before.
# STRIPE_SECRET_KEY=sk_test_...
# Optional. From `stripe listen` in development or the Dashboard's webhook
# endpoint in production; lets a payment be recorded even if the customer
# closes the tab before returning from Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional. Signs the payment links operators send (/pay/RS-…?token=…).
# Unset, a key derived from STRIPE_SECRET_KEY is used. Changing it cancels
# every outstanding link.
# PAYMENT_LINK_SECRET=
