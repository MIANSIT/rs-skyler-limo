# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
PORT=4000

# MySQL runs on the same host as the API and is not reachable from the internet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rsskyler
DB_PASSWORD=
DB_NAME=rsskyler
DB_CONNECTION_LIMIT=10

# Browser origins allowed to POST a booking or a quote. Comma separated.
# Server-to-server calls from the Next.js app send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:3000

# How long an operator stays signed in to /admin.
SESSION_TTL_HOURS=12

# Development only, read by `npm run seed`. Omit and a password is generated
# and printed once.
# SEED_ADMIN_EMAIL=ops@rsskylerlimo.com
# SEED_ADMIN_PASSWORD=

# Uploaded vehicle photography. Keep this OUTSIDE the deploy directory in
# production (e.g. /var/lib/rsskyler/uploads) so a release does not delete the
# client's photo library, and include it in the nightly backup.
UPLOADS_DIR=./var/uploads

# How a browser reaches those files. In production let nginx serve the uploads
# directory from the public origin and set this to
# https://rsskylerlimo.com/uploads — that keeps images on the CDN and off the
# API process.
UPLOADS_BASE_URL=http://127.0.0.1:4000/uploads
